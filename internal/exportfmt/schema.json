{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "goalie-export-schema",
  "title": "Goalie export event",
  "description": "Each line in a goalie JSONL export is one of these event types.",
  "oneOf": [
    {
      "title": "create_goal",
      "description": "Records the user gesture of creating a goal.",
      "type": "object",
      "required": ["type", "id", "description", "created"],
      "additionalProperties": false,
      "properties": {
        "type":        { "type": "string", "const": "create_goal" },
        "id":          { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "created":     { "type": "string", "format": "date-time" }
      }
    },
    {
      "title": "close_goal",
      "description": "Records the user gesture of closing a goal.",
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "const": "close_goal" },
        "id":   { "type": "string", "minLength": 1 }
      }
    },
    {
      "title": "log_entry",
      "description": "Records the user gesture of logging a journal entry.",
      "type": "object",
      "required": ["type", "id", "ts", "username", "blocked", "done", "note", "schema_version"],
      "additionalProperties": false,
      "properties": {
        "type":           { "type": "string", "const": "log_entry" },
        "id":             { "type": "string", "minLength": 1 },
        "ts":             { "type": "string", "format": "date-time" },
        "username":       { "type": "string", "minLength": 1 },
        "goal":           { "type": ["string", "null"] },
        "task":           { "type": ["string", "null"] },
        "blocked":        { "type": "boolean" },
        "done":           { "type": "boolean" },
        "note":           { "type": "string" },
        "schema_version": { "type": "string" },
        "unblocks":       { "type": ["string", "null"] }
      }
    },
    {
      "title": "set_motd",
      "description": "Records the user gesture of publishing a message of the day.",
      "type": "object",
      "required": ["type", "ts", "content"],
      "additionalProperties": false,
      "properties": {
        "type":    { "type": "string", "const": "set_motd" },
        "ts":      { "type": "string", "format": "date-time" },
        "content": { "type": "string", "minLength": 1 }
      }
    }
  ]
}
